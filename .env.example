# Student Complaint Management System - environment variables (template)
#
# The app reads REAL environment variables (System.getenv); it does not load
# this file. Use it as a reference and export the values in your shell:
#   PowerShell:  $env:DB_PASSWORD = "change_me"
#   cmd:         set DB_PASSWORD=change_me
#   Linux/macOS: export DB_PASSWORD=change_me
#
# Do NOT commit a real .env file (it is git-ignored).

# JDBC URL. Must include the database name for auto-setup to work.
DB_URL=jdbc:mysql://localhost:3306/student_complaint_system?useSSL=false&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=change_me

# Allow the app to run "CREATE DATABASE IF NOT EXISTS" on startup.
# Requires the DB user to have the CREATE privilege.
# Set to false if the database is created manually by a DBA; the app will then
# only create tables inside the existing database.
AUTO_CREATE_DB=true
